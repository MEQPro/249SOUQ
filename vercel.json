{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/q",
      "destination": "/products.html?utm_source=qr&utm_medium=print&utm_campaign=bukhoor_launch",
      "permanent": false
    }
  ],
  "crons": [
    { "path": "/api/seller-applications?type=ping", "schedule": "0 5 * * *" }
  ],
  "rewrites": [
    {
      "source": "/dashboard/:slug",
      "destination": "/seller/dashboard"
    }
  ]
}
