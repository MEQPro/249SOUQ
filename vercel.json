{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/q",
      "destination": "/products.html?utm_source=qr&utm_medium=print&utm_campaign=bukhoor_launch",
      "permanent": false
    },
    {
      "source": "/b",
      "destination": "/products?utm_source=qr&utm_medium=sticker&utm_campaign=bukhoor_label",
      "permanent": false
    },
    {
      "source": "/d",
      "destination": "/delka?utm_source=qr&utm_medium=sticker&utm_campaign=delka_label",
      "permanent": false
    },
    {
      "source": "/map",
      "destination": "https://maps.app.goo.gl/A6ufRW2RK8kYZudN7?g_st=iw",
      "permanent": false
    }
  ],
  "crons": [
    { "path": "/api/seller-applications?type=ping", "schedule": "0 5 * * *" }
  ],
  "rewrites": [
    {
      "source": "/dashboard/:slug",
      "destination": "/seller/dashboard"
    }
  ]
}
